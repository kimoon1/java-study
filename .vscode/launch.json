
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Java UTF-8 Debug",
            "request": "launch",
            "mainClass": "${file}",
            "console": "internalConsole",
            "encoding": "UTF-8",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"
        }
    ]
}
